{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chrome"],
      "enabled": true,
      "timeout": 30000
    },
    "drive": {
      "type": "local",
      "command": ["npx", "-y", "@piotr-agier/google-drive-mcp"],
      "environment": {
        "GOOGLE_DRIVE_MCP_SCOPES": "drive.readonly,drive.file"
      },
      "enabled": true
    },
    "open-design": {
      "type": "local",
      "command": ["node", "C:\\Users\\dell\\Desktop\\Quanti_Delta\\.tools\\open-design\\apps\\daemon\\bin\\od.mjs", "mcp", "--daemon-url", "http://127.0.0.1:7456"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "flutter run*": "ask",
      "flutter build*": "ask",
      "Stop-Process*": "ask"
    },
    "edit": {
      "*": "ask"
    }
  }
}