/.playwright-mcp/
/*.png
/errors.txt
/release-errors.txt
/research_*.json
/tools/mobbin_findings.json
/design/

# Local dev tools (Open Design monorepo, etc.)
/.tools/
/.od-skills/

# Dev pipeline state (churns every ticket)
/.opencode/perf-state.json
