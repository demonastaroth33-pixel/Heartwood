# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dev artifacts (Playwright MCP logs/snapshots, root-level UI review screenshots,
